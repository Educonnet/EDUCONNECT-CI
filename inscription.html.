<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inscription | EDUCONNECT CI</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f8fc;
      color: #17324d;
    }
    header {
      background: #073b70;
      color: white;
      text-align: center;
      padding: 22px;
    }
    main {
      width: min(92%, 480px);
      margin: 30px auto;
      padding: 24px;
      background: white;
      border-radius: 12px;
    }
    label {
      display: block;
      margin-top: 16px;
      font-weight: bold;
    }
    input {
      width: 100%;
      margin-top: 7px;
      padding: 12px;
      border: 1px solid #bdcbd9;
      border-radius: 7px;
      font-size: 16px;
    }
    button {
      width: 100%;
      margin-top: 22px;
      padding: 13px;
      border: 0;
      border-radius: 7px;
      background: #087b55;
      color: white;
      font-size: 16px;
      font-weight: bold;
    }
    a { color: #087b55; }
    #message { line-height: 1.5; overflow-wrap: anywhere; }
  </style>
</head>
<body>
  <header>
    <h1>EDUCONNECT CI</h1>
    <p>Créer un compte apprenant</p>
  </header>

  <main>
    <h2>Inscription</h2>
    <p>Crée ton compte pour accéder aux formations.</p>

    <form id="formInscription">
      <label for="nom">Nom complet</label>
      <input id="nom" type="text" autocomplete="name" required>

      <label for="email">Adresse e-mail</label>
      <input id="email" type="email" autocomplete="email" required>

      <label for="motdepasse">Mot de passe (8 caractères minimum)</label>
      <input id="motdepasse" type="password"
             minlength="8" autocomplete="new-password" required>

      <button id="boutonInscription" type="submit">
        Créer mon compte
      </button>
    </form>

    <p id="message" role="status" aria-live="polite"></p>
    <p>Déjà inscrit ? <a href="connexion.html">Se connecter</a></p>
    <p><a href="index.html">Retour à l’accueil</a></p>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="supabase.js"></script>
  <script>
    const formulaire = document.getElementById("formInscription");
    const message = document.getElementById("message");
    const bouton = document.getElementById("boutonInscription");

    formulaire.addEventListener("submit", async function(event) {
      event.preventDefault();
      message.textContent = "";

      const nom = document.getElementById("nom").value.trim();
      const email = document.getElementById("email").value.trim();
      const motdepasse = document.getElementById("motdepasse").value;

      if (!window.eduSupabase) {
        message.textContent =
          "Connexion au service indisponible. Réessaie plus tard.";
        return;
      }

      bouton.disabled = true;
      bouton.textContent = "Inscription en cours...";

      try {
        const { data, error } = await window.eduSupabase.auth.signUp({
          email: email,
          password: motdepasse,
          options: {
            data: { full_name: nom }
          }
        });

        if (error) throw error;

        if (data.session) {
          message.textContent =
            "Compte créé ! Tu peux maintenant te connecter.";
        } else {
          message.textContent =
            "Demande d’inscription envoyée. Consulte ta boîte e-mail pour confirmer ton adresse avant de te connecter.";
        }

        formulaire.reset();
      } catch (erreur) {
        console.error("Erreur d’inscription :", erreur);
        message.textContent =
          "Inscription impossible : " + erreur.message;
      } finally {
        bouton.disabled = false;
        bouton.textContent = "Créer mon compte";
      }
    });
  </script>
</body>
</html>
